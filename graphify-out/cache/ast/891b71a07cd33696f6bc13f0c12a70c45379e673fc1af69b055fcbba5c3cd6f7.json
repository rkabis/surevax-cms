ow\">Tender &middot; cashier mode</span>\n          <h2 className=\"text-xl font-semibold mt-1 font-mono tabular-nums\">\n            Settle &#8369;{fmtMoney(totals.netAmount)}\n          </h2>\n          <p className=\"text-xs text-muted-foreground mt-0.5\">\n            Keyboard-first &middot; scan-to-pull &middot; one keystroke commits.\n          </p>\n        </div>\n        <span className=\"font-mono text-2xs text-muted-foreground shrink-0 mt-0.5 whitespace-nowrap\">\n          FSM &middot; {fsmLabel}\n        </span>\n      </div>\n\n      {/* Body - scrollable */}\n      <div className=\"flex-1 overflow-y-auto px-5 py-4 space-y-4\">\n        {/* Method tabs */}\n        <div>\n          <Tabs value={method} onValueChange={(v: string) => onMethodChange(v as PayMethod)}>\n            <TabsList className=\"grid grid-cols-6 w-full\">\n              <TabsTrigger value=\"cash\">\n                Cash <kbd className=\"ml-1 text-2xs opacity-60\">1</kbd>\n              </TabsTrigger>\n              <TabsTrigger value=\"card\">\n                Card <kbd className=\"ml-1 text-2xs opacity-60\">2</kbd>\n              </TabsTrigger>\n              <TabsTrigger value=\"gcash\">\n                GCash <kbd className=\"ml-1 text-2xs opacity-60\">3</kbd>\n              </TabsTrigger>\n              <TabsTrigger value=\"maya\">\n                Maya <kbd className=\"ml-1 text-2xs opacity-60\">4</kbd>\n              </TabsTrigger>\n              <TabsTrigger value=\"hmo\">\n                HMO <kbd className=\"ml-1 text-2xs opacity-60\">5</kbd>\n              </TabsTrigger>\n              <TabsTrigger value=\"split\">\n                Split <kbd className=\"ml-1 text-2xs opacity-60\">6</kbd>\n              </TabsTrigger>\n            </TabsList>\n          </Tabs>\n        </div>\n\n        {/* Tendered field */}\n        <div className=\"space-y-2\">\n          <span className=\"eyebrow\">Tendered</span>\n          <div className=\"flex items-center h-11 px-3.5 border border-input rounded-md bg-background\">\n            <span className=\"font-mono text-muted-foreground mr-1\">&#8369;</span>\n            <span className=\"font-mono tabular-nums text-2xl font-semibold flex-1 leading-none\">\n              {tendered.toLocaleString('en-PH', {\n                minimumFractionDigits: 2,\n                maximumFractionDigits: 2,\n              })}\n            </span>\n          </div>\n          <div className=\"flex gap-1.5\">\n            <Button\n              type=\"button\"\n              variant=\"outline\"\n              size=\"sm\"\n              className=\"flex-1 text-xs\"\n              onClick={() => addToTendered(500)}\n            >\n              +&#8369;500\n            </Button>\n            <Button\n              type=\"button\"\n              variant=\"outline\"\n              size=\"sm\"\n              className=\"flex-1 text-xs\"\n              onClick={()", "is_member_call": false, "source_file": "/Users/njvil/Documents/Personal_Projects/surevax-cms-revamp/.claude/worktrees/nervous-babbage-a0443b/apps/frontend/src/features/transactions/components/TenderRail.tsx", "source_location": "L81"}, {"caller_nid": "components_tenderrail_tenderrail", "callee": "fmtMoney", "is_member_call": false, "source_file": "/Users/njvil/Documents/Personal_Projects/surevax-cms-revamp/.claude/worktrees/nervous-babbage-a0443b/apps/frontend/src/features/transactions/components/TenderRail.tsx", "source_location": "L88"}]}