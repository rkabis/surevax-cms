# Backend env, normally generated automatically per worktree by `pnpm run setup`
# (scripts/setup-worktree.sh). See .claude/rules/worktree.md.
#
# This file is the manual-setup reference. Values match docker-compose.dev.yml
# so a hand-copied .env Just Works against `docker compose -f
# docker-compose.dev.yml up -d`. Use Railway URLs only when you explicitly
# want to test against shared dev data (.claude/rules/railway.md).

# ── Database ──────────────────────────────────────────────────────────────────
# Local dev: matches docker-compose.dev.yml defaults.
# Production (Railway): use DATABASE_PUBLIC_URL — the private `.railway.internal`
# host is only reachable from inside Railway containers.
DATABASE_URL=postgresql://surevax:surevax_dev_password@localhost:5432/surevax_dev
# Production must use a distinct privileged migrator role. Local development
# may omit this and fall back to DATABASE_URL.
# DATABASE_MIGRATOR_URL=

# ── Runtime ───────────────────────────────────────────────────────────────────
# One of: development | test | production
# In production the backend will refuse to start if:
#   • auth secrets look like dev defaults or are <32 chars
#   • CORS_ORIGIN is not an exact HTTPS origin
#   • runtime/migrator roles are not separated
#   • workers, Sentry, PayMongo verification, or R2 are not fully configured
NODE_ENV=development
PORT=3000

# ── Auth secrets ──────────────────────────────────────────────────────────────
# Dev values are fine locally. Generate real secrets for production with:
#   openssl rand -base64 48
JWT_SECRET=dev_jwt_secret_change_in_production
COOKIE_SECRET=dev_cookie_secret_change_in_production
# Required in every environment (production values must be unique and random).
JWT_ACCESS_SECRET=dev_access_secret_change_in_production_32_chars
JWT_REFRESH_SECRET=dev_refresh_secret_change_in_production_32_chars

# ── CORS ──────────────────────────────────────────────────────────────────────
# Must match the frontend origin exactly. No safe default — missing = boot fail.
# Production example: CORS_ORIGIN=https://surevax-cms.pages.dev
CORS_ORIGIN=http://localhost:5173
# Parsed strictly: only true/1 enable details. Production rejects either value.
EXPOSE_ERRORS=false

# Production admission requires workers and security alert delivery. Local
# development defaults to false and may omit Sentry.
WORKERS_ENABLED=false
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.0

# Production requires PayMongo webhook verification.
# PAYMONGO_WEBHOOK_SECRET=

# Production PHI admission requires all four R2 values together.
# R2_ENDPOINT=https://<accountId>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=surevax-attachments
