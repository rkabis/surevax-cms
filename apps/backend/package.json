{
  "name": "@surevax/backend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build:shared": "pnpm --filter @surevax/shared build",
    "predev": "pnpm run build:shared",
    "dev": "tsx watch src/index.ts",
    "prebuild": "pnpm run build:shared",
    "build": "tsc && rm -rf dist/drizzle && cp -R drizzle dist/drizzle",
    "start": "node dist/index.js",
    "pretypecheck": "pnpm run build:shared",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:deploy": "tsx src/shared/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/shared/db/seed.ts",
    "pregen:contracts": "pnpm run build:shared",
    "migration:preflight": "tsx src/scripts/migrationPreflight.ts",
    "migration:rehearse": "tsx --no-cache src/scripts/rehearseAppsheetMigration.ts",
    "migration:trial:local": "tsx --no-cache src/scripts/runLocalMigrationTrial.ts",
    "gen:contracts": "tsx src/contracts/generate.ts",
    "incident-access": "tsx src/tools/emergencyAccess.ts",
    "pretest": "pnpm run build:shared",
    "test": "vitest run",
    "pretest:unit": "pnpm --filter @surevax/shared build",
    "test:unit": "vitest run --project unit",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1048.0",
    "@aws-sdk/s3-request-presigner": "^3.1048.0",
    "@sentry/node": "^10.53.1",
    "@surevax/shared": "workspace:*",
    "bcrypt": "^5.0.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "drizzle-orm": "^0.40.0",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.0.0",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.0",
    "pdfkit": "^0.18.0",
    "pino": "^9.0.0",
    "pino-http": "^10.5.0",
    "postgres": "^3.0.0",
    "qrcode": "^1.5.4",
    "speakeasy": "^2.0.0",
    "zod": "^3.0.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.0",
    "@types/cookie-parser": "^1.4.6",
    "@types/cors": "^2.8.0",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/node": "^22.0.0",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "@types/speakeasy": "^2.0.10",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^4.1.5",
    "drizzle-kit": "^0.30.0",
    "pino-pretty": "^11.0.0",
    "supertest": "^7.2.2",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.5"
  }
}
