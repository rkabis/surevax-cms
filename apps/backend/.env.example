# Backend env, normally generated by `pnpm run setup` per worktree.
# See .claude/rules/worktree.md for the bootstrap flow.
#
# Manual usage:
#   - Local docker: copy the values from .env.example at the repo root
#     (which match docker-compose.dev.yml defaults).
#   - Railway dev DB: use the Railway-pulled values below as a starting
#     point. Pull current values with:
#         railway variables --service Postgres --json          → DATABASE_PUBLIC_URL
#         railway variables --service surevax-cms-revamp --json → all other vars
#
# IMPORTANT: Use DATABASE_PUBLIC_URL (not the private postgres.railway.internal URL).
#
# AUTH-2 two-role split (2026-05-28 capstone):
#   DATABASE_URL           → surevax_app (NOBYPASSRLS)   — what the app runs as.
#   DATABASE_MIGRATOR_URL  → surevax (BYPASSRLS + DDL)   — migrations + seed only.
# On Railway both URLs come from the same Postgres service, but the role +
# password differs. The railway-ops skill documents the one-time
# `CREATE ROLE surevax_app` + ALTER PASSWORD provisioning steps.

DATABASE_URL=postgresql://surevax_app:<app-password>@<host>:<port>/<db>
DATABASE_MIGRATOR_URL=<DATABASE_PUBLIC_URL from Railway Postgres service>
NODE_ENV=development
PORT=3000
COOKIE_SECRET=<from surevax-cms-revamp service, ≥32 chars>
JWT_SECRET=<from surevax-cms-revamp service, ≥32 chars>
JWT_ACCESS_SECRET=<from surevax-cms-revamp service, ≥32 chars>
JWT_REFRESH_SECRET=<from surevax-cms-revamp service, ≥32 chars>
CORS_ORIGIN=http://localhost:5173
# Parsed strictly: only true/1 enable details. Production rejects either value.
EXPOSE_ERRORS=false
WORKERS_ENABLED=false
# Optional — Google Places API key for address autocomplete.
# GOOGLE_PLACES_API_KEY=

# Cloudflare R2 — required for presigned PUT URL generation (attachment uploads).
# Without these, GET /api/attachments/:id/upload-url returns 503 STORAGE_NOT_CONFIGURED.
# Obtain from: Cloudflare dashboard → R2 → your bucket → Manage R2 API Tokens.
# R2_ENDPOINT=https://<accountId>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=surevax-attachments
#
# R2 bucket CORS note: the bucket must allow PUT from the frontend origin.
# In the Cloudflare R2 dashboard → bucket → Settings → CORS Policy, add:
#   AllowedOrigins: [https://yourdomain.com]
#   AllowedMethods: [PUT]
#   AllowedHeaders: [Content-Type]
#   MaxAgeSeconds: 3600

# Sentry error aggregation (M14). Init is skipped when SENTRY_DSN is blank
# so local dev works without a Sentry project. In production, set via Railway
# env vars. Obtain from: sentry.io → Project → Settings → Client Keys (DSN).
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.0

# PayMongo webhook signing secret. When unset, inbound webhook signature
# verification is skipped with a WARNING (dev-only acceptable): production
# deploys should always set this. Obtain from: PayMongo dashboard →
# Developers → Webhooks → Signing secret.
# PAYMONGO_WEBHOOK_SECRET=
