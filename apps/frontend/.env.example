# Frontend env, normally generated by `pnpm run setup` per worktree.
# Copy to .env.local (gitignored) for manual setup.
# Only VITE_* vars are exposed to the browser bundle.

# Backend API base URL.
# Leave empty in local dev — Vite proxies /api to the backend
# (see vite.config.ts). Set to the Railway backend URL for production builds:
#   VITE_API_URL=https://surevax-cms-revamp-production.up.railway.app
VITE_API_URL=

# Per-worktree dev server config — written by scripts/setup-worktree.sh so
# two worktrees can run `pnpm dev` simultaneously without colliding. Vite
# falls back to 5173 / http://localhost:3000 if these are unset.
VITE_DEV_PORT=5173
VITE_API_PROXY_TARGET=http://localhost:3000

# Sentry error aggregation (M14). main.tsx skips init when VITE_SENTRY_DSN is
# blank, so local dev works without a Sentry project. Obtain from:
# sentry.io → Project → Settings → Client Keys (DSN).
# VITE_SENTRY_DSN=
# VITE_SENTRY_ENVIRONMENT=production

# Multi-tenant deploys override this per build so the frontend targets a
# specific tenant slug instead of the seeded default. Leave unset in local dev.
# VITE_TENANT_SLUG=SVX
